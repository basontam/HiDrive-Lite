# HiDrive-Lite public example configuration.
# Copy this file to .env and change only the values needed for your setup.
# Secrets are entered in the protected Settings page and encrypted at rest.

# local is the safe default for a first run. Use access only after configuring
# a compatible reverse proxy/Cloudflare Access application.
HIDRIVE_AUTH_MODE=local
HIDRIVE_PUBLIC_ORIGIN=http://127.0.0.1:12367

# Relative paths work when the process starts from the repository root.
HIDRIVE_DATA_DIR=./data
HIDRIVE_MASTER_KEY_FILE=./secrets/master.key

HIDRIVE_BIND=127.0.0.1
HIDRIVE_PORT=12367

# OpenList is optional. Leave the defaults when the OpenList integration is
# not installed; the media library and non-115 links still work.
OPENLIST_URL=http://127.0.0.1:5244
OPENLIST_DB=./data/openlist.db
OPENLIST_115PAN_PATH=/115pan
OPENLIST_115STRM_PATH=/115strm
STRM_ROOT=./data/strm

# Optional HDHive check-in path. Do not put an app secret or OAuth token here.
HDHIVE_CHECKIN_PATH=/api/open/checkin

# Optional operational switches.
LIBRARY_ENRICH_AUTOSTART=1
TMDB_DAILY_BUDGET=300
