# Copy to /etc/hidrive-public/hidrive-lite.env and edit for this host.
# Keep this file free of provider secrets; enter those in Settings instead.
HIDRIVE_AUTH_MODE=local
HIDRIVE_PUBLIC_ORIGIN=http://127.0.0.1:12367
HIDRIVE_DATA_DIR=/var/lib/hidrive-lite/data
HIDRIVE_MASTER_KEY_FILE=/var/lib/hidrive-lite/secrets/master.key
HIDRIVE_BIND=127.0.0.1
HIDRIVE_PORT=12367
OPENLIST_URL=http://127.0.0.1:5244
OPENLIST_DB=/var/lib/hidrive-lite/data/openlist.db
OPENLIST_115PAN_PATH=/115pan
OPENLIST_115STRM_PATH=/115strm
STRM_ROOT=/var/lib/hidrive-lite/data/strm
HDHIVE_CHECKIN_PATH=/api/open/checkin
LIBRARY_ENRICH_AUTOSTART=1
TMDB_DAILY_BUDGET=300
