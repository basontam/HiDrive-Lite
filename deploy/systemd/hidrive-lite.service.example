[Unit]
Description=HiDrive-Lite personal media library
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hidrive-lite
Group=hidrive-lite
WorkingDirectory=/opt/hidrive-lite
EnvironmentFile=/etc/hidrive-public/hidrive-lite.env
ExecStart=/opt/hidrive-lite/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:12367 --error-logfile - app:app
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hidrive-lite
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
